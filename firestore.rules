rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsExistingDoc() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwnDoc() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function keepsOwnerImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }

    function isCollector() {
      return isSignedIn() && 'role' in request.auth.token && request.auth.token.role == 'collector';
    }

    function isNestedReader(masterUserId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/nestedAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/nestedAccounts/$(request.auth.uid)).data.masterUserId == masterUserId;
    }

    function isNestedUserOf(ownerUid) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nested'
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parentUid == ownerUid
         && (!get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['active']) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false))
        ||
        (exists(/databases/$(database)/documents/nestedAccounts/$(request.auth.uid))
         && (get(/databases/$(database)/documents/nestedAccounts/$(request.auth.uid)).data.ownerUid == ownerUid
             || get(/databases/$(database)/documents/nestedAccounts/$(request.auth.uid)).data.masterUserId == ownerUid)
         && (!get(/databases/$(database)/documents/nestedAccounts/$(request.auth.uid)).data.keys().hasAny(['active']) ||
             get(/databases/$(database)/documents/nestedAccounts/$(request.auth.uid)).data.active != false))
      );
    }

    function canReadDoc() {
      return isSignedIn() && (
        resource == null
        || resource.data.userId == request.auth.uid
        || isNestedUserOf(resource.data.userId)
      );
    }

    function canWriteNestedPayment() {
      return isSignedIn()
        && request.resource.data.masterUserId == resource.data.masterUserId
        && request.resource.data.nestedUserId == request.auth.uid;
    }

    function validNonNegative(field) {
      return !request.resource.data.keys().hasAny([field]) ||
        (request.resource.data[field] is number && request.resource.data[field] >= 0);
    }

    function validOptionalNonNegativeInteger(field) {
      return !request.resource.data.keys().hasAny([field]) ||
        (request.resource.data[field] is int && request.resource.data[field] >= 0);
    }

    function validPositive(field) {
      return !request.resource.data.keys().hasAny([field]) ||
        (request.resource.data[field] is number && request.resource.data[field] > 0);
    }

    function validString(field, maxLength) {
      return !request.resource.data.keys().hasAny([field]) ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= maxLength);
    }

    function validRequiredString(field, maxLength) {
      return request.resource.data.keys().hasAny([field]) &&
        request.resource.data[field] is string &&
        request.resource.data[field].size() > 0 &&
        request.resource.data[field].size() <= maxLength;
    }

    function validOptionalBoolean(field) {
      return !request.resource.data.keys().hasAny([field]) ||
        request.resource.data[field] is bool;
    }

    function validEnum(field, allowed) {
      return !request.resource.data.keys().hasAny([field]) ||
        request.resource.data[field] in allowed;
    }

    function validCoordinates() {
      return (!request.resource.data.keys().hasAny(['latitude']) ||
        (request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90)) &&
        (!request.resource.data.keys().hasAny(['longitude']) ||
        (request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180));
    }

    function validOptionalCustomRecommendation() {
      return !request.resource.data.keys().hasAny(['customRecommendedLoanAmount']) ||
        (resource != null &&
          resource.data.get('customRecommendedLoanAmount', null) == request.resource.data.customRecommendedLoanAmount) ||
        (request.resource.data.customRecommendedLoanAmount is number &&
          request.resource.data.customRecommendedLoanAmount > 0 &&
          request.resource.data.customRecommendedLoanAmount <= 50000000 &&
          request.resource.data.customRecommendedLoanAmount % 1 == 0);
    }

    function validVillageFields() {
      return validString('id', 80) &&
        validRequiredString('name', 120) &&
        validString('dayOfWeek', 20) &&
        validEnum('shift', ['Morning', 'Evening']);
    }

    function validCustomerFields() {
      return validString('id', 80) &&
        validRequiredString('name', 160) &&
        validString('phone', 24) &&
        validString('alternativePhone', 24) &&
        validString('aadhar', 20) &&
        validString('locationDesc', 300) &&
        validString('villageId', 80) &&
        validString('coName', 160) &&
        validNonNegative('coId') &&
        validNonNegative('numericalId') &&
        validOptionalNonNegativeInteger('renewalRevision') &&
        validNonNegative('createdAt') &&
        validOptionalBoolean('isActive') &&
        validOptionalBoolean('aadharSubmitted') &&
        validOptionalBoolean('passportPhotoSubmitted') &&
        validOptionalCustomRecommendation() &&
        validCoordinates();
    }

    function validLoanAmounts() {
      return validPositive('principalAmount') &&
        validPositive('interestAmount') &&
        validPositive('totalPayable') &&
        validNonNegative('balanceAmount') &&
        validNonNegative('startDate') &&
        validString('id', 80) &&
        validString('customerId', 80) &&
        validEnum('status', ['ACTIVE', 'CLOSED', 'RENEWED']) &&
        validEnum('disbursement_mode', ['CASH', 'PHONE']) &&
        validEnum('disbursementMode', ['CASH', 'PHONE']);
    }

    function validPaymentAmount() {
      return validNonNegative('amountPaid') &&
        validNonNegative('paymentDate') &&
        validNonNegative('weekNumber') &&
        validString('id', 80) &&
        validString('loanId', 80) &&
        validString('customerId', 80) &&
        validString('notes', 500) &&
        validEnum('paymentType', ['REGULAR', 'DUE', 'RENEWAL_CLOSURE']) &&
        validEnum('paymentMode', ['CASH', 'PHONE']) &&
        validEnum('type', ['CASH', 'PHONE', 'DUE']);
    }

    function validUserProfileFields() {
      return validString('id', 80) &&
        validString('userId', 80) &&
        validString('email', 240) &&
        validString('accountNotes', 20000) &&
        validNonNegative('cashOpeningBalance') &&
        validNonNegative('phonePeOpeningBalance') &&
        (!request.resource.data.keys().hasAny(['walletOpeningDate']) ||
          request.resource.data.walletOpeningDate is number ||
          request.resource.data.walletOpeningDate is timestamp) &&
        validString('role', 40) &&
        validString('parentUid', 80) &&
        validOptionalBoolean('active') &&
        validNonNegative('createdAt');
    }

    function keepsProfileIdentityImmutable() {
      return request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('parentUid', null) == resource.data.get('parentUid', null);
    }

    function validInvestmentPlan(planId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'name', 'currentBalance', 'monthlyContribution', 'annualReturnPercent',
          'withdrawalStartDate', 'monthlyWithdrawal', 'minimumBalance', 'notes', 'status', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'currentBalance', 'monthlyContribution', 'annualReturnPercent',
          'withdrawalStartDate', 'monthlyWithdrawal', 'endDate', 'minimumBalance', 'notes', 'status', 'updatedAt'
        ]) &&
        data.id == planId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.currentBalance is number && data.currentBalance >= 0 && data.currentBalance <= 1000000000000 &&
        data.monthlyContribution is number && data.monthlyContribution >= 0 && data.monthlyContribution <= 1000000000000 &&
        data.annualReturnPercent is number && data.annualReturnPercent >= -99 && data.annualReturnPercent <= 100 &&
        data.withdrawalStartDate is number && data.withdrawalStartDate > 0 &&
        data.monthlyWithdrawal is number && data.monthlyWithdrawal > 0 && data.monthlyWithdrawal <= 1000000000000 &&
        data.minimumBalance is number && data.minimumBalance >= 0 && data.minimumBalance <= 1000000000000 &&
        data.notes is string && data.notes.size() <= 1000 &&
        data.status in ['active', 'paused'] &&
        data.updatedAt is number && data.updatedAt > 0 &&
        (!data.keys().hasAny(['endDate']) || (data.endDate is number && data.endDate >= data.withdrawalStartDate));
    }

    function validPrivateCashFlowSettings() {
      let data = request.resource.data;
      return data.keys().hasOnly(['minimumCashReserve', 'updatedAt']) &&
        data.keys().hasAny(['minimumCashReserve', 'updatedAt']) &&
        (!data.keys().hasAny(['minimumCashReserve']) ||
          (data.minimumCashReserve is number && data.minimumCashReserve >= 0 && data.minimumCashReserve <= 1000000000000)) &&
        (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is number && data.updatedAt > 0));
    }

    function validMoneyEntryFields() {
      return validPositive('amount') &&
        validNonNegative('date') &&
        validString('id', 80) &&
        validString('description', 500) &&
        validString('investorName', 160) &&
        validEnum('payment_mode', ['CASH', 'PHONE']);
    }

    function validExpenseFields() {
      return validMoneyEntryFields() && validRequiredString('description', 500);
    }

    function validAiSuggestionsFields() {
      return validString('id', 80) &&
        validString('userId', 80) &&
        validNonNegative('lastUpdated') &&
        validNonNegative('updatedAt') &&
        (!request.resource.data.keys().hasAny(['suggestions']) ||
          request.resource.data.suggestions is list);
    }

    function validBlockedAadhaarFields() {
      return validString('aadhaarNumber', 12) &&
        validString('aadhaar', 12) &&
        validString('reason', 500) &&
        validString('blockedBy', 80) &&
        validString('blocked_by', 80);
    }

    function validNestedPaymentFields() {
      return validPositive('amountPaid') &&
        validNonNegative('paymentDate') &&
        validNonNegative('weekNumber') &&
        validString('id', 80) &&
        validString('loanId', 80) &&
        validString('customerId', 80) &&
        validString('customerName', 160) &&
        validString('masterUserId', 80) &&
        validString('nestedUserId', 80) &&
        validEnum('paymentMode', ['CASH', 'PHONE']);
    }

    function validNestedTransactionFields() {
      return request.resource.data.ownerUid is string &&
        request.resource.data.nestedUid is string &&
        request.resource.data.customerId is string && request.resource.data.customerId.size() <= 120 &&
        request.resource.data.customerName is string && request.resource.data.customerName.size() <= 160 &&
        request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000000000 &&
        request.resource.data.date is number && request.resource.data.date >= 0 &&
        request.resource.data.type is string && request.resource.data.type.size() > 0 && request.resource.data.type.size() <= 64 &&
        request.resource.data.notes is string && request.resource.data.notes.size() <= 1000 &&
        validOptionalBoolean('exported') &&
        validNonNegative('processingFeeAmount') &&
        validOptionalBoolean('processingFeeCharged');
    }

    function validNestedExpenseFields() {
      return request.resource.data.ownerUid is string &&
        request.resource.data.nestedUid is string &&
        request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000000 &&
        request.resource.data.date is number && request.resource.data.date >= 0 &&
        validString('note', 1000);
    }

    function validNestedCustomerFields(docId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'numericalId', 'name', 'phone', 'alternativePhone', 'aadhar', 'coName', 'coId',
          'locationDesc', 'latitude', 'longitude', 'villageId', 'masterUserId', 'nestedUserId',
          'createdAt', 'isActive', 'isTemp', 'principal', 'processingFeeCharged',
          'processingFeeAmount', 'disbursementMode'
        ]) &&
        data.keys().hasOnly([
          'id', 'numericalId', 'name', 'phone', 'alternativePhone', 'aadhar', 'coName', 'coId',
          'locationDesc', 'latitude', 'longitude', 'villageId', 'masterUserId', 'nestedUserId',
          'createdAt', 'isActive', 'isTemp', 'principal', 'processingFeeCharged',
          'processingFeeAmount', 'disbursementMode'
        ]) &&
        data.id == docId && data.id is string && data.id.size() <= 80 &&
        data.numericalId is number && data.numericalId >= 0 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        validString('phone', 24) && validString('alternativePhone', 24) && validString('aadhar', 20) &&
        validString('coName', 160) && (data.coId == null || (data.coId is number && data.coId >= 0)) &&
        validString('locationDesc', 300) &&
        (data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
        (data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
        data.villageId is string && data.villageId.size() > 0 && data.villageId.size() <= 80 &&
        data.masterUserId is string && data.nestedUserId == request.auth.uid &&
        data.createdAt is number && data.createdAt > 0 &&
        data.isActive == true && data.isTemp == true &&
        data.principal is number && data.principal > 0 && data.principal <= 1000000000000 &&
        data.processingFeeCharged is bool && data.processingFeeAmount is number &&
        data.processingFeeAmount >= 0 && data.processingFeeAmount <= data.principal &&
        data.disbursementMode in ['CASH', 'PHONE'];
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isNestedUserOf(uid) || (resource.data.role == 'nested' && resource.data.parentUid == request.auth.uid));
      allow create: if isSignedIn() && (
        (request.auth.uid == uid && (
          ((!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'owner') &&
           (!request.resource.data.keys().hasAny(['parentUid']) || request.resource.data.parentUid == null)) ||
          (request.resource.data.role == 'nested' && request.resource.data.parentUid is string &&
           exists(/databases/$(database)/documents/nestedAccounts/$(uid)) &&
           (get(/databases/$(database)/documents/nestedAccounts/$(uid)).data.get('ownerUid', null) == request.resource.data.parentUid ||
            get(/databases/$(database)/documents/nestedAccounts/$(uid)).data.get('masterUserId', null) == request.resource.data.parentUid) &&
           (!get(/databases/$(database)/documents/nestedAccounts/$(uid)).data.keys().hasAny(['active']) ||
            get(/databases/$(database)/documents/nestedAccounts/$(uid)).data.active != false))
        )) ||
        (request.resource.data.role == 'nested' && request.resource.data.parentUid == request.auth.uid)
      ) && validUserProfileFields();
      allow update: if isSignedIn() && keepsProfileIdentityImmutable() &&
        ((request.auth.uid == uid && request.resource.data.get('active', null) == resource.data.get('active', null)) ||
         (resource.data.role == 'nested' && resource.data.parentUid == request.auth.uid)) &&
        validUserProfileFields();
      allow delete: if isSignedIn() && resource.data.role == 'nested' && resource.data.parentUid == request.auth.uid;
    }

    // Keep financial planning private to the account owner. Nested collectors
    // can read the owner profile under existing rules, but cannot read this data.
    match /users/{uid}/investmentPlans/{planId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid && validInvestmentPlan(planId);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/privateFinance/{settingsId} {
      allow read: if isSignedIn() && request.auth.uid == uid && settingsId == 'settings';
      allow create, update: if isSignedIn() && request.auth.uid == uid && settingsId == 'settings' && validPrivateCashFlowSettings();
      allow delete: if false;
    }

    match /villages/{docId} {
      allow read: if canReadDoc();
      allow create: if createsOwnDoc() && validVillageFields();
      allow update: if ownsExistingDoc() && keepsOwnerImmutable() && validVillageFields();
      allow delete: if ownsExistingDoc();
    }

    match /customers/{docId} {
      allow read: if canReadDoc();
      allow create: if createsOwnDoc() && validCustomerFields();
      allow update: if ownsExistingDoc() && keepsOwnerImmutable() && validCustomerFields();
      allow delete: if ownsExistingDoc();
    }

    match /loans/{docId} {
      allow read: if canReadDoc();
      allow create: if createsOwnDoc() && validLoanAmounts();
      allow update: if (ownsExistingDoc() || isNestedUserOf(resource.data.userId)) && keepsOwnerImmutable() && validLoanAmounts();
      allow delete: if ownsExistingDoc();
    }

    match /payments/{docId} {
      allow read: if canReadDoc();
      allow create: if (createsOwnDoc() || (isSignedIn() && request.resource.data.nestedUid == request.auth.uid)) && validPaymentAmount();
      allow update: if (ownsExistingDoc() || (isSignedIn() && resource.data.nestedUid == request.auth.uid && request.resource.data.nestedUid == resource.data.nestedUid)) && keepsOwnerImmutable() && validPaymentAmount();
      allow delete: if ownsExistingDoc() || (isSignedIn() && resource.data.nestedUid == request.auth.uid);
    }

    match /blockedAadhaar/{docId} {
      allow read: if canReadDoc();
      allow create: if createsOwnDoc() && validBlockedAadhaarFields();
      allow update: if ownsExistingDoc() && keepsOwnerImmutable() && validBlockedAadhaarFields();
      allow delete: if ownsExistingDoc();
    }

    match /balancingFund/{docId} {
      allow read: if isSignedIn() && (
        // Standard BF doc (userId == auth)
        (resource != null && resource.data.userId == request.auth.uid)
        // Nested BF doc (ownerUid == auth or nestedUid == auth)
        || (resource != null && resource.data.keys().hasAny(['isNestedBF'])
            && (resource.data.ownerUid == request.auth.uid || resource.data.nestedUid == request.auth.uid))
        || resource == null
      );
      allow create: if isSignedIn() && (
        (request.resource.data.userId == request.auth.uid)
        || (request.resource.data.keys().hasAny(['isNestedBF']) && request.resource.data.ownerUid == request.auth.uid)
      ) && validNonNegative('amount') && validString('dateStr', 20);
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid)
        || (resource.data.keys().hasAny(['isNestedBF']) && resource.data.ownerUid == request.auth.uid)
      ) && validNonNegative('amount') && validString('dateStr', 20);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /investments/{docId} {
      allow read: if canReadDoc();
      allow create: if createsOwnDoc() && validMoneyEntryFields();
      allow update: if ownsExistingDoc() && keepsOwnerImmutable() && validMoneyEntryFields();
      allow delete: if ownsExistingDoc();
    }

    match /expenses/{docId} {
      allow read: if canReadDoc();
      allow create: if createsOwnDoc() && validExpenseFields();
      allow update: if ownsExistingDoc() && keepsOwnerImmutable() && validExpenseFields();
      allow delete: if ownsExistingDoc();
    }

    // Nested Accounts: master creates/manages the doc
    match /nestedAccounts/{docId} {
      allow read: if isSignedIn() && (
        request.auth.uid == docId
        || resource.data.ownerUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.auth.uid != docId &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.masterUserId == request.auth.uid &&
        request.resource.data.nestedUid == docId;
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.masterUserId == resource.data.masterUserId &&
        request.resource.data.nestedUid == resource.data.nestedUid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Nested Transactions: nested user enters payments, owner reconciles them
    match /nestedTransactions/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.nestedUid == request.auth.uid
        && isNestedUserOf(request.resource.data.ownerUid)
        && validNestedTransactionFields();
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.nestedUid == request.auth.uid
      );
      allow update: if isSignedIn() && validNestedTransactionFields() &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.nestedUid == resource.data.nestedUid &&
        ((resource.data.ownerUid == request.auth.uid) ||
         (resource.data.nestedUid == request.auth.uid && resource.data.exported == false && request.resource.data.exported == resource.data.exported));
      allow delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.nestedUid == request.auth.uid && resource.data.exported == false)
      );
    }

    // Nested Payments: nested user records payments; master reads them
    match /nestedPayments/{docId} {
      allow read: if isSignedIn() && (
        resource.data.masterUserId == request.auth.uid 
        || (resource.data.nestedUserId == request.auth.uid && isCollector())
      );
      allow create: if isSignedIn() 
        && request.resource.data.nestedUserId == request.auth.uid 
        && isCollector()
        && isNestedReader(request.resource.data.masterUserId);
      allow update: if false;
      allow delete: if false;
    }

    // Nested Customers: nested user records temporary new registrations; master reads them
    match /nestedCustomers/{docId} {
      allow read: if isSignedIn() && (
        resource.data.masterUserId == request.auth.uid 
        || resource.data.nestedUserId == request.auth.uid
      );
      allow create: if isSignedIn() 
        && request.resource.data.nestedUserId == request.auth.uid 
        && isNestedUserOf(request.resource.data.masterUserId)
        && validNestedCustomerFields(docId);
      allow update: if false;
      allow delete: if isSignedIn() && (
        resource.data.masterUserId == request.auth.uid 
        || resource.data.nestedUserId == request.auth.uid
      );
    }

    // Nested OTP: nested user requests OTP; master reads/updates by email
    match /nestedOtp/{docId} {
      allow read: if isSignedIn() && (
        resource.data.masterEmail == request.auth.token.email  // master reads by email
        || resource.data.nestedUserId == request.auth.uid      // nested user who created it
      );
      allow create: if isSignedIn() && request.resource.data.nestedUserId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.nestedUserId == request.auth.uid
        || resource.data.masterEmail == request.auth.token.email  // master updates by email
      );
      allow delete: if false;
    }

    // Nested Expenses: nested user records their own expenses; owner can read
    match /nestedExpenses/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.nestedUid == request.auth.uid
        && isNestedUserOf(request.resource.data.ownerUid)
        && validNestedExpenseFields();
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.nestedUid == request.auth.uid
      );
      allow update: if isSignedIn() && resource.data.nestedUid == request.auth.uid &&
        request.resource.data.nestedUid == resource.data.nestedUid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        validNestedExpenseFields();
      allow delete: if isSignedIn() && resource.data.nestedUid == request.auth.uid;
    }

    match /aiSuggestions/{docId} {
      allow read: if ownsExistingDoc() && request.auth.uid == docId;
      allow create: if createsOwnDoc() && request.auth.uid == docId && validAiSuggestionsFields();
      allow update: if ownsExistingDoc() && keepsOwnerImmutable() && request.auth.uid == docId && validAiSuggestionsFields();
      allow delete: if ownsExistingDoc() && request.auth.uid == docId;
    }

    match /debugLogs/{docId} {
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['timestamp', 'userUid', 'message']) &&
        request.resource.data.keys().hasAll(['timestamp', 'userUid', 'message']) &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.timestamp is number &&
        request.resource.data.timestamp >= 0 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 120;
      allow read: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
